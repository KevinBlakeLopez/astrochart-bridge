{
  "id": "./",
  "name": "AstroChart Bridge",
  "short_name": "AstroChart",
  "description": "Open a natal chart's sky in Stellarium Web, or the chart in Astro-Seek, from a screenshot, pasted text or a file, and see which planets were visible.",
  "lang": "en",
  "start_url": "index.html",
  "scope": "./",
  "display": "standalone",
  "file_handlers": [
    {
      "action": "import.html",
      "accept": {
        "application/x-aaf": [".aaf"],
        "application/x-morinus-hor": [".hor"]
      }
    }
  ],
  "background_color": "#0b1d3a",
  "theme_color": "#0b1d3a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
