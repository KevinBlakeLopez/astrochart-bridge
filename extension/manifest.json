{
  "manifest_version": 3,
  "name": "Chart Bridge",
  "version": "0.1.0",
  "description": "Open the sky for an Astro-Seek natal chart in Stellarium Web.",
  "action": {
    "default_title": "Chart Bridge",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
